{
  "name": "carnet-de-credit",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "description": "Application mobile-first PWA de gestion de crédits et dettes (MAD / DH)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
